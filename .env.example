NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=agent-tool-server-game-prices
SERVICE_VERSION=0.1.0
GIT_SHA=unknown
PUBLIC_BASE_URL=

# Development only. Production rejects disabled authentication.
AUTH_MODE=disabled
API_KEYS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# PriceCharting API access requires a paid subscription. Never expose this token to callers.
PRICECHARTING_API_TOKEN=
PRICECHARTING_API_BASE_URL=https://www.pricecharting.com/api/
PRICECHARTING_TIMEOUT_MS=10000
PRICECHARTING_CONCURRENCY=1
PRICECHARTING_REQUESTS_PER_SECOND=1
PRICECHARTING_RETRY_COUNT=2
PRICECHARTING_MAX_BACKOFF_MS=5000
PRICECHARTING_MAX_SEARCH_RESULTS=20
PRICECHARTING_MAX_COLLECTION_ENTRIES=25
PRICECHARTING_ATTRIBUTION_TEXT=Price data provided by PriceCharting
PRICECHARTING_ATTRIBUTION_URL=https://www.pricecharting.com

# Production refuses to start unless written redistribution permission is acknowledged.
PRICECHARTING_REDISTRIBUTION_APPROVED=false
PRICECHARTING_ENABLE_COMPARISON=true
PRICECHARTING_ENABLE_COLLECTION_ESTIMATES=false
PRICECHARTING_MATCH_THRESHOLD=0.75
PRICECHARTING_AMBIGUITY_MARGIN=0.05
